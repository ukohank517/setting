# ghostty setting
# doc: https://ghostty.org/docs/config
# reload: cmd+shift+, / edit: cmd+,

####################################################
#################### appearance ####################
####################################################

# color theme. see all: `ghostty +list-themes`
theme = TokyoNight

# HackGen Console NF = Hack + 源柔ゴシック + Nerd Font
# full-width char is exactly 2x of half-width, so japanese keeps the columns
font-family = HackGen Console NF
font-size = 13

# breathing room around the text area
window-padding-x = 8
window-padding-y = 6

################################################
#################### window ####################
################################################

# restore windows and tabs after quit
window-save-state = always

##################################################
#################### keyboard ####################
##################################################

# treat option as alt, so emacs style M-b / M-f work in bash and emacs.
# set to false if you need option for special characters.
macos-option-as-alt = true

###############################################
#################### shell ####################
###############################################

# ghostty sets TERM=xterm-ghostty, which most servers have no terminfo for,
# so less/vim over ssh warn "terminal is not fully functional".
# ssh-env: the shell integration wraps `ssh` to send TERM=xterm-256color
# (plus COLORTERM etc.) to the remote, while the local shell keeps
# xterm-ghostty. add `ssh-terminfo` to instead install xterm-ghostty on the
# remote via tic (needs tic there, falls back to ssh-env when missing).
# unlisted features (cursor, title, path, ...) keep their defaults.
shell-integration-features = ssh-env
