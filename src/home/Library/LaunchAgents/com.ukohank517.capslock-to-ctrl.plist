<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Caps Lock (0x700000039) -> Left Control (0x7000000E0) をログインごとに適用する。
         hidutil はキーボードのデバイス差に依存しないので、どのキーボードにも効く。 -->
    <key>Label</key>
    <string>com.ukohank517.capslock-to-ctrl</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/hidutil</string>
        <string>property</string>
        <string>--set</string>
        <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":30064771129,"HIDKeyboardModifierMappingDst":30064771296}]}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
