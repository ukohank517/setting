# ghostty setting
# doc: https://ghostty.org/docs/config
# reload: cmd+shift+, / edit: cmd+,

####################################################
#################### appearance ####################
####################################################

# color theme. see all: `ghostty +list-themes`
theme = TokyoNight

# HackGen Console NF = Hack + 源柔ゴシック + Nerd Font
# full-width char is exactly 2x of half-width, so japanese keeps the columns
font-family = HackGen Console NF
font-size = 13

# breathing room around the text area
window-padding-x = 8
window-padding-y = 6

################################################
#################### window ####################
################################################

# restore windows and tabs after quit
window-save-state = always

##################################################
#################### keyboard ####################
##################################################

# treat option as alt, so emacs style M-b / M-f work in bash and emacs.
# set to false if you need option for special characters.
macos-option-as-alt = true

# splits are done by herdr, not ghostty. send herdr's prefix (ctrl+b = \x02)
# so cmd+d keeps working as "split". NOTE: outside herdr these keys just
# type the sequence into the shell.
keybind = super+d=text:\x02v
keybind = super+shift+d=text:\x02-
