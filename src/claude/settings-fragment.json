{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"💬 \\\\u001b[31m%s\\\\u001b[0m\"}' \"$(date +%H:%M:%S)\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"🤖 \\\\u001b[31m%s\\\\u001b[0m\"}' \"$(date +%H:%M:%S)\""
          }
        ]
      }
    ]
  }
}
