{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"💬 \\\\u001b[31m%s\\\\u001b[0m\"}' \"$(date \"+%Y-%m-%d %H:%M:%S\")\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"🤖 \\\\u001b[31m%s\\\\u001b[0m\"}' \"$(date \"+%Y-%m-%d %H:%M:%S\")\""
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Read(*.key)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(sudo:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "tui": "fullscreen",
  "theme": "custom:dark-budou"
}
