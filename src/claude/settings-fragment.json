{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "showMessageTimestamps": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"⏰ %s\"}' \"$(date +%H:%M:%S)\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"✅ %s\"}' \"$(date +%H:%M:%S)\""
          }
        ]
      }
    ]
  }
}
